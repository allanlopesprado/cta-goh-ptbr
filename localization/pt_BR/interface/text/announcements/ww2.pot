msgctxt "announce_ww2sale"
msgid "81 years have passed since the end of the Second World War in Europe.\n\n Call to Arms - Gates of Hell remembers and honours the combatants that took part in the most devastating conflict in history.\n\n <c(f5d167)>Enjoy one week of discount, complete your collection!</c>"
msgstr "Já se passaram 81 anos desde o fim da Segunda Guerra Mundial na Europa.\n\n Call to Arms - Gates of Hell recorda e homenageia os combatentes que participaram do conflito mais devastador da história.\n\n <c(f5d167)>Aproveite uma semana de descontos e complete sua coleção!</c>"

msgctxt "button/discounts"
msgid "<c(f5d167)>CHECK THE DISCOUNTS!</c>"
msgstr "<c(f5d167)>CONFIRA OS DESCONTOS!</c>"
