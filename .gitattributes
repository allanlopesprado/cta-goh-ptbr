# Normalizar line endings dos arquivos de localização para LF
localization/**/*.pot text eol=lf
localization/**/*.info text eol=lf

# A referência inglesa preserva os bytes do pacote, inclusive CRLF, para os hashes da revisão.
localization/en/**/*.pot -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
localization/en/localization.info -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Scripts Python
*.py text eol=lf

# Ferramentas e workflows compartilhados com a CI Linux
*.mjs text eol=lf
*.yml text eol=lf

# Documentação
*.md text eol=lf
